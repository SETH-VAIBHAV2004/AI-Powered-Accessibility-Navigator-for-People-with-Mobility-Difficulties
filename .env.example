# Copy to .env and replace every value. Never commit .env.

APP_ENV=development
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
LOG_LEVEL=INFO

# Development uses SQLite under instance/ when DATABASE_URL is unset.
# Production (Docker) must use MySQL, for example:
# DATABASE_URL=mysql+mysqlconnector://navigator:password@db:3306/navigator
DATABASE_URL=

# Set to 1 only behind the bundled Nginx (or another trusted reverse proxy).
TRUST_PROXY=0

# MySQL, used by docker-compose. The app reads DATABASE_URL, not these names.
MYSQL_DATABASE=navigator
MYSQL_USER=navigator
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-root-password

# Shared rate-limit storage. memory:// is per process. Use Redis when
# Gunicorn runs more than one worker in production.
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_DEFAULT=60 per minute

# Identifies this app to Nominatim and Overpass. Put a real contact address in it.
OSM_USER_AGENT=AccessibilityNavigator/0.1 (educational project; contact: you@example.com)
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org

# No fixed campus. A route loads a corridor around the start and destination,
# expanded in every direction, and refuses a single query larger than this span.
MAX_BBOX_SPAN_DEGREES=0.15
BBOX_MARGIN_METRES=350
